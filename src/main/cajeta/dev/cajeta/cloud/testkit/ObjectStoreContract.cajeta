package dev.cajeta.cloud.testkit;

import cajeta.concurrent.AtomicInt64;
import cajeta.lang.String;
import dev.cajeta.cloud.Capabilities;
import dev.cajeta.cloud.Caps;
import dev.cajeta.cloud.CloudException;
import dev.cajeta.cloud.object.CondResult;
import dev.cajeta.cloud.object.ListPage;
import dev.cajeta.cloud.object.MultipartUpload;
import dev.cajeta.cloud.object.ObjectReader;
import dev.cajeta.cloud.object.ObjectStore;
import dev.cajeta.cloud.object.ObjectWriter;
import dev.cajeta.cloud.object.StatResult;

/**
 * The conformance testkit (spec §10, §14.1) — what makes "swap the
 * provider" trustworthy rather than aspirational. One suite exercises
 * the WHOLE port through the interface; any adapter repo calls
 * {@link #verify} with its store and a scratch prefix it may write
 * under, and passes or fails (§10.1). Selection is
 * capability-conditional (§10.2): a declared capability is TESTED, an
 * undeclared one is asserted to fail cleanly per §3.2 — and where the
 * port permits providers to differ (listing order, §10.5), the suite
 * tests the DOCUMENTED guarantee, not incidental behaviour. The
 * §10.3 concurrent-writer check runs REAL fibers.
 *
 * A violation throws a CloudException whose operation field is the
 * contract check id; no throw = conformant.
 */
public final class ObjectStoreContract {

    static void fail(String check, String detail) {
        throw heap CloudException(CloudException.PROVIDER_ERROR(),
            "contract", check, "-", detail);
    }

    static void check(boolean ok, String checkId, String detail) {
        if (!ok) { ObjectStoreContract.fail(checkId, detail); }
        return;
    }

    static #int8[] bytesOf(String s) {
        return s.toBytes();
    }

    static #String textOf(int8[] b) {
        int8[] copy = heap int8[(int64) b.count()];
        int64 i = 0;
        while (i < (int64) copy.count()) { copy[i] = b[i]; i = i + 1; }
        String s = heap String(#copy, (int32) b.count());
        return #s;
    }

    /** Run the full conformance suite; throws on the first violation. */
    public static void verify(ObjectStore s, String prefix) {
        ObjectStoreContract.roundtripAndAbsence(s, prefix);
        ObjectStoreContract.ranges(s, prefix);
        ObjectStoreContract.listing(s, prefix);
        ObjectStoreContract.streaming(s, prefix);
        ObjectStoreContract.multipart(s, prefix);
        ObjectStoreContract.serverCopy(s, prefix);
        ObjectStoreContract.conditional(s, prefix);
        ObjectStoreContract.concurrentWriters(s, prefix);
        return;
    }

    static void roundtripAndAbsence(ObjectStore s, String prefix) {
        int8[] v1 #= ObjectStoreContract.bytesOf("contract-v1");
        String e1 #= s.put(prefix + "rt", v1, "text/plain");
        ObjectStoreContract.check(e1.count() > 0, "put-etag",
            "put must return a non-empty version token");
        ObjectStoreContract.check(
            ObjectStoreContract.textOf(s.get(prefix + "rt"))
                .equals("contract-v1"),
            "roundtrip", "get must return the exact bytes put");
        StatResult st #= s.stat(prefix + "rt");
        ObjectStoreContract.check(st.exists && st.size == 11,
            "stat", "stat must report existence and size");
        ObjectStoreContract.check(st.etag.equals(e1),
            "stat-etag", "stat must carry the current version token");
        // Overwrite rotates the token.
        int8[] v2 #= ObjectStoreContract.bytesOf("contract-v2!");
        String e2 #= s.put(prefix + "rt", v2, "text/plain");
        ObjectStoreContract.check(!e2.equals(e1), "etag-rotates",
            "an overwrite must produce a NEW version token");
        // Absence is explicit.
        boolean threw = false;
        try {
            int8[] never #= s.get(prefix + "absent");
        } catch (CloudException e) {
            threw = e.kind() == CloudException.NOT_FOUND();
        }
        ObjectStoreContract.check(threw, "absence-get",
            "get of a missing key must throw NOT_FOUND");
        ObjectStoreContract.check(!s.stat(prefix + "absent").exists,
            "absence-stat", "stat of a missing key must say exists=false");
        ObjectStoreContract.check(!s.delete(prefix + "absent"),
            "delete-reports", "delete must report the key was absent");
        ObjectStoreContract.check(s.delete(prefix + "rt"),
            "delete-reports", "delete must report the key existed");
        ObjectStoreContract.check(!s.stat(prefix + "rt").exists,
            "delete-removes", "a deleted key must be absent");
        return;
    }

    static void ranges(ObjectStore s, String prefix) {
        Capabilities caps = s.capabilities();
        if (!caps.supports(Caps.RANGE_READ())) {
            // Undeclared → must fail cleanly per §3.2, never truncate.
            String e0 #= s.put(prefix + "rg",
                ObjectStoreContract.bytesOf("0123456789"), "t");
            boolean threw = false;
            try {
                int8[] never #= s.getRange(prefix + "rg", (int64) 0,
                    (int64) 4);
            } catch (CloudException e) {
                threw = true;
            }
            ObjectStoreContract.check(threw, "range-undeclared",
                "getRange without the capability must fail, not degrade");
            return;
        }
        int8[] v #= ObjectStoreContract.bytesOf("0123456789");
        String e1 #= s.put(prefix + "rg", v, "t");
        ObjectStoreContract.check(
            ObjectStoreContract.textOf(
                s.getRange(prefix + "rg", (int64) 3, (int64) 4))
                .equals("3456"),
            "range-slice", "a range read must return exactly the slice");
        ObjectStoreContract.check(
            ObjectStoreContract.textOf(
                s.getRange(prefix + "rg", (int64) 8, (int64) 50))
                .equals("89"),
            "range-clamp", "a range past the end must clamp, not fail");
        boolean threw = false;
        try {
            int8[] never #= s.getRange(prefix + "rg", (int64) 10,
                (int64) 1);
        } catch (CloudException e) {
            threw = true;
        }
        ObjectStoreContract.check(threw, "range-unsatisfiable",
            "an offset at/past the end must fail explicitly (§6.2)");
        return;
    }

    static void listing(ObjectStore s, String prefix) {
        int8[] v #= ObjectStoreContract.bytesOf("x");
        String e1 #= s.put(prefix + "list/b", v, "t");
        String e2 #= s.put(prefix + "list/a", v, "t");
        String e3 #= s.put(prefix + "list/sub/deep", v, "t");
        String e4 #= s.put(prefix + "list/c", v, "t");
        // Paginate at 2; collect everything.
        int64 seen = 0;
        String token = "";
        boolean more = true;
        String prev = "";
        boolean orderedHeld = true;
        while (more) {
            ListPage p #= s.list(prefix + "list/", "", token, (int64) 2);
            int64 i = 0;
            while (i < p.count()) {
                String k #= p.keyAt(i);
                if (prev.count() > 0 && prev.compareTo(k) >= 0) {
                    orderedHeld = false;
                }
                prev = "" + k;
                seen = seen + 1;
                i = i + 1;
            }
            token #= p.nextToken();
            more = token.count() > 0;
            // §10.5: the ORDERED guarantee is tested only where
            // declared in-band.
            if (p.ordered != s.capabilities()
                    .supports(Caps.LIST_ORDERED())) {
                ObjectStoreContract.fail("list-ordered-flag",
                    "ListPage.ordered must match the declared capability");
            }
        }
        ObjectStoreContract.check(seen == 4, "list-complete",
            "pagination must enumerate every key exactly once");
        if (s.capabilities().supports(Caps.LIST_ORDERED())) {
            ObjectStoreContract.check(orderedHeld, "list-order",
                "declared lexicographic order must actually hold");
        }
        // Delimiter grouping.
        ListPage d #= s.list(prefix + "list/", "/", "", (int64) 100);
        ObjectStoreContract.check(d.count() == 3
            && d.prefixCount() == 1, "list-delimiter",
            "a delimiter must group nested keys into common prefixes");
        return;
    }

    static void streaming(ObjectStore s, String prefix) {
        ObjectWriter w #= s.openWrite(prefix + "stream", "t");
        int8[] c1 #= ObjectStoreContract.bytesOf("chunk-one|");
        int8[] c2 #= ObjectStoreContract.bytesOf("chunk-two");
        w.write(c1, (int64) c1.count());
        ObjectStoreContract.check(!s.stat(prefix + "stream").exists,
            "write-atomic", "no partial object may be visible mid-write");
        w.write(c2, (int64) c2.count());
        String etag #= w.complete();
        ObjectStoreContract.check(
            ObjectStoreContract.textOf(s.get(prefix + "stream"))
                .equals("chunk-one|chunk-two"),
            "write-assembles", "complete() must install every chunk");
        ObjectWriter w2 #= s.openWrite(prefix + "aborted", "t");
        w2.write(c1, (int64) c1.count());
        w2.abort();
        ObjectStoreContract.check(!s.stat(prefix + "aborted").exists,
            "write-abort", "an aborted write must leave nothing");
        // Streaming read returns the full object.
        ObjectReader r #= s.openRead(prefix + "stream");
        int8[] buf = heap int8[7];
        int64 total = 0;
        int64 got = r.read(buf, (int64) 7);
        while (got >= 0) {
            total = total + got;
            got = r.read(buf, (int64) 7);
        }
        r.close();
        ObjectStoreContract.check(total == 19, "read-streams",
            "a streaming read must deliver the whole object");
        return;
    }

    static void multipart(ObjectStore s, String prefix) {
        Capabilities caps = s.capabilities();
        if (!caps.supports(Caps.MULTIPART())) {
            boolean threw = false;
            try {
                MultipartUpload never #= s.beginMultipart(
                    prefix + "mp", "t");
            } catch (CloudException e) {
                threw = true;
            }
            ObjectStoreContract.check(threw, "multipart-undeclared",
                "beginMultipart without the capability must fail cleanly");
            return;
        }
        MultipartUpload up #= s.beginMultipart(prefix + "mp", "t");
        int8[] p2 #= ObjectStoreContract.bytesOf("-beta");
        int8[] p1 #= ObjectStoreContract.bytesOf("alpha");
        up.addPart(2, p2);
        up.addPart(1, p1);
        ObjectStoreContract.check(!s.stat(prefix + "mp").exists,
            "multipart-invisible",
            "an incomplete upload must never be readable (§8.2)");
        String etag #= up.complete();
        ObjectStoreContract.check(
            ObjectStoreContract.textOf(s.get(prefix + "mp"))
                .equals("alpha-beta"),
            "multipart-order", "parts must assemble in part-number order");
        MultipartUpload up2 #= s.beginMultipart(prefix + "mp2", "t");
        up2.addPart(1, p1);
        up2.abort();
        ObjectStoreContract.check(!s.stat(prefix + "mp2").exists,
            "multipart-abort", "an aborted upload must leave nothing");
        return;
    }

    static void serverCopy(ObjectStore s, String prefix) {
        int8[] v #= ObjectStoreContract.bytesOf("copy-me");
        String e1 #= s.put(prefix + "cp-src", v, "text/plain");
        if (!s.capabilities().supports(Caps.SERVER_SIDE_COPY())) {
            boolean threw = false;
            try {
                String never #= s.copy(prefix + "cp-src",
                    prefix + "cp-dst");
            } catch (CloudException e) {
                threw = true;
            }
            ObjectStoreContract.check(threw, "copy-undeclared",
                "copy without the capability must fail naming it (§3.2)");
            return;
        }
        String e2 #= s.copy(prefix + "cp-src", prefix + "cp-dst");
        ObjectStoreContract.check(
            ObjectStoreContract.textOf(s.get(prefix + "cp-dst"))
                .equals("copy-me"),
            "copy-bytes", "a copy must duplicate the bytes");
        return;
    }

    static void conditional(ObjectStore s, String prefix) {
        Capabilities caps = s.capabilities();
        int8[] a #= ObjectStoreContract.bytesOf("A");
        int8[] b #= ObjectStoreContract.bytesOf("B");
        if (caps.supports(Caps.COND_PUT_CREATE())) {
            CondResult w1 #= s.putIfAbsent(prefix + "cond", a, "t");
            ObjectStoreContract.check(w1.won, "cond-create-wins",
                "the first creator must win");
            CondResult l1 #= s.putIfAbsent(prefix + "cond", b, "t");
            ObjectStoreContract.check(!l1.won, "cond-must-lose",
                "the SECOND creator must lose — an always-winning "
                + "driver makes every concurrency test lie (§14.4)");
            ObjectStoreContract.check(l1.etag.equals(w1.etag),
                "cond-loser-token",
                "the loser must learn the current version token");
            ObjectStoreContract.check(
                ObjectStoreContract.textOf(s.get(prefix + "cond"))
                    .equals("A"),
                "cond-loser-noop", "a lost write must change nothing");
        } else {
            boolean threw = false;
            try {
                CondResult never #= s.putIfAbsent(prefix + "cond", a,
                    "t");
            } catch (CloudException e) {
                threw = true;
            }
            ObjectStoreContract.check(threw, "cond-create-undeclared",
                "putIfAbsent without the capability must fail cleanly");
        }
        if (caps.supports(Caps.COND_PUT_OVERWRITE())) {
            String cur #= s.put(prefix + "cas", a, "t");
            CondResult w2 #= s.putIfMatch(prefix + "cas", b, "t", cur);
            ObjectStoreContract.check(w2.won, "cas-current-wins",
                "a putIfMatch holding the current token must win");
            CondResult l2 #= s.putIfMatch(prefix + "cas", a, "t", cur);
            ObjectStoreContract.check(!l2.won && l2.etag.equals(w2.etag),
                "cas-stale-loses",
                "a STALE token must lose and report the current one");
        } else {
            String cur2 #= s.put(prefix + "cas", a, "t");
            boolean threw = false;
            try {
                CondResult never #= s.putIfMatch(prefix + "cas", b, "t",
                    cur2);
            } catch (CloudException e) {
                threw = true;
            }
            ObjectStoreContract.check(threw, "cas-undeclared",
                "putIfMatch without the capability must fail cleanly");
        }
        return;
    }

    static async void racer(ObjectStore s, AtomicInt64 wins,
                            String key, int32 id) {
        int8[] payload = heap int8[1];
        payload[0] = (int8) id;
        CondResult r #= s.putIfAbsent(key, payload,
            "application/octet-stream");
        if (r.won) { wins.fetchAdd((int64) 1); }
        return;
    }

    /** §10.3 — REAL concurrent writers; exactly one may win. */
    static void concurrentWriters(ObjectStore s, String prefix) {
        if (!s.capabilities().supports(Caps.COND_PUT_CREATE())) {
            return;                    // gated with the capability
        }
        AtomicInt64 wins = heap AtomicInt64((int64) 0);
        String key = prefix + "race";
        scope {
            spawn racer(s, wins, key, 1);
            spawn racer(s, wins, key, 2);
            spawn racer(s, wins, key, 3);
            spawn racer(s, wins, key, 4);
            spawn racer(s, wins, key, 5);
            spawn racer(s, wins, key, 6);
        }
        ObjectStoreContract.check(wins.load() == 1,
            "concurrent-one-winner",
            "exactly ONE of 6 racing conditional creators may win "
            + "(§7.4, §10.3); observed " + wins.load());
        return;
    }
}
