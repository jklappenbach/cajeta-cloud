package dev.cajeta.cloud.object;

import cajeta.collection.ArrayList;
import cajeta.lang.Int64;
import cajeta.lang.String;
import dev.cajeta.cloud.CloudException;

/**
 * The memory driver's multipart upload (spec §8): parts land in any
 * order (re-upload replaces), {@link #complete} assembles them in
 * part-number order and installs atomically; until then — and forever
 * after {@link #abort} — NO readable object exists (§8.2).
 */
final class MemoryMultipart implements MultipartUpload {

    MemState st;
    String key;
    String contentType;
    ArrayList<Int64> nums;
    ArrayList<Blob> datas;         // parallel to nums; Blob reused as
                                   // a byte-holder (meta fields unused)
    boolean open;

    MemoryMultipart(MemState st, String key,
                    String contentType) {
        this.st = st;
        this.key = "" + key;
        this.contentType = "" + contentType;
        this.nums = heap ArrayList<Int64>();
        this.datas = heap ArrayList<Blob>();
        this.open = true;
        return;
    }

    public void addPart(int32 partNumber, int8[] bytes) {
        if (!this.open) {
            throw heap CloudException(CloudException.PROVIDER_ERROR(),
                "memory", "addPart", this.key, "upload already closed");
        }
        if (partNumber < 1 || partNumber > 10000) {
            throw heap CloudException(CloudException.PROVIDER_ERROR(),
                "memory", "addPart", this.key, "part number "
                + (int64) partNumber + " out of [1, 10000]");
        }
        int64 n = (int64) bytes.count();
        int8[] copy = heap int8[n];
        int64 i = 0;
        while (i < n) { copy[i] = bytes[i]; i = i + 1; }
        String ct = "";
        String et = "";
        Blob holder = heap Blob(#copy, #ct, (int64) 0, #et);
        // Replace an existing part with the same number, else append.
        int32 p = 0;
        while (p < this.nums.count()) {
            if (this.nums.get(p).value() == (int64) partNumber) {
                this.datas.set(p, #holder);
                return;
            }
            p = p + 1;
        }
        this.nums.add(Int64.of((int64) partNumber));
        this.datas.add(#holder);
        return;
    }

    public #String complete() {
        if (!this.open) {
            throw heap CloudException(CloudException.PROVIDER_ERROR(),
                "memory", "complete", this.key, "upload already closed");
        }
        if (this.nums.count() == 0) {
            throw heap CloudException(CloudException.PROVIDER_ERROR(),
                "memory", "complete", this.key, "no parts uploaded");
        }
        this.open = false;
        // Order part indexes by part number (selection over the list).
        int32 m = this.nums.count();
        int32[] order = heap int32[m];
        boolean[] used = heap boolean[m];
        int32 r = 0;
        while (r < m) {
            int32 best = -1;
            int32 p = 0;
            while (p < m) {
                if (!used[p]) {
                    if (best < 0 || this.nums.get(p).value()
                        < this.nums.get(best).value()) {
                        best = p;
                    }
                }
                p = p + 1;
            }
            order[r] = best;
            used[best] = true;
            r = r + 1;
        }
        int64 total = 0;
        r = 0;
        while (r < m) {
            total = total + (int64) this.datas.get(order[r]).bytes.count();
            r = r + 1;
        }
        int8[] all = heap int8[total];
        int64 at = 0;
        r = 0;
        while (r < m) {
            Blob b = this.datas.get(order[r]);
            int64 n = (int64) b.bytes.count();
            int64 i = 0;
            while (i < n) { all[at + i] = b.bytes[i]; i = i + 1; }
            at = at + n;
            r = r + 1;
        }
        return this.st.install(this.key, all, total, this.contentType);
    }

    public void abort() {
        this.open = false;
        return;
    }
}
