package dev.cajeta.cloud.queue;

import cajeta.collection.ArrayList;
import cajeta.lang.String;
import dev.cajeta.cloud.Capabilities;
import dev.cajeta.cloud.CloudStats;

/**
 * The queue port (cajeta-cloud-cloudflare spec 5.1): each message goes to one
 * consumer, who holds it by receipt for a visibility window and acknowledges
 * or releases it; an unacknowledged message is delivered again with its
 * attempt count raised. Delivery is at least once and unordered; FIFO,
 * exactly-once and message groups are capabilities (`Caps.QUEUE_*`), never
 * assumptions. Dead-letter queues are the provider's to configure (5.1.6).
 */
public interface MessageQueue {

    Capabilities capabilities();

    CloudStats stats();

    /** Sends one message, visible after `delaySeconds` (0 for now); returns its id. */
    #String send(int8[] body, MessageAttributes attributes, int64 delaySeconds);

    /** Sends several; returns their ids in order. */
    #String[] sendBatch(ArrayList<Outgoing> messages);

    /**
     * Up to `max` messages no other consumer holds, each held by its receipt
     * for `visibilitySeconds`; empty when none is available.
     */
    #Received receive(int32 max, int64 visibilitySeconds);

    /** The message is done; it is not delivered again. An expired or unknown receipt is PRECONDITION_FAILED. */
    void ack(String receipt);

    void ackAll(ArrayList<String> receipts);

    /** Gives the message back, available again after `delaySeconds`. */
    void release(String receipt, int64 delaySeconds);
}
