package dev.cajeta.cloud;

/**
 * cajeta-cloud — one platform-agnostic API for the services every
 * cloud provides. Ports + in-memory drivers + conformance testkits,
 * NOTHING else (spec §1.4): `capabilities: []`, no filesystem, no
 * network, no provider SDK. Every real backend is a separate adapter
 * artifact that implements a port and passes its conformance suite.
 *
 * Verticals in this release: the OBJECT-STORE port (§4–§8, including
 * the conditional writes cajeta-dqe's no-consensus design rests on),
 * the STREAM port (§12, shaped against Kinesis and Kafka) and the
 * minimal cut of the IDENTITY port (registration, confirmation,
 * lookup, attributes, groups).
 *
 * This is the library entry class (the `--emit=cja` root).
 */
public final class Cloud {
    /** The library version; run-tests.sh gates it against cajeta.json. */
    public static #String version() { return "0.2.0"; }

    /** `--emit=cja` entry. */
    public static int32 run() { return 0; }
}
