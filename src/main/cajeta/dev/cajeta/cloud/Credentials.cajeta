package dev.cajeta.cloud;

import cajeta.lang.String;

/**
 * Provider credentials with REDACTION AT THE BOUNDARY (spec §9.5,
 * §14.9): adapters read {@link #accessKeyId} and {@link #secretKey}
 * for signing, but everything that could reach a log — toString, and
 * therefore any message built from it — shows at most the first four
 * characters of the access key id and NEVER the secret. Error paths
 * that mention credentials must go through {@link #redacted}.
 */
public final class Credentials {

    String keyId;
    String secret;

    public Credentials(String accessKeyId, String secretKey) {
        this.keyId = "" + accessKeyId;
        this.secret = "" + secretKey;
        return;
    }

    /** For signing only — never interpolate into a message. */
    public #String accessKeyId() {
        String out = "" + this.keyId;
        return #out;
    }

    /** For signing only — never interpolate into a message. */
    public #String secretKey() {
        String out = "" + this.secret;
        return #out;
    }

    /** The ONLY loggable rendering: `AKIA…[redacted]`. */
    public #String redacted() {
        int32 keep = 4;
        if (this.keyId.byteLength() < keep) {
            keep = this.keyId.byteLength();
        }
        String out = this.keyId.substring((int32) 0, keep)
            + "…[redacted]";
        return #out;
    }

    public #String toString() {
        return this.redacted();
    }
}
