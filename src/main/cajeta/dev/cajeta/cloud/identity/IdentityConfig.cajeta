package dev.cajeta.cloud.identity;

import cajeta.lang.String;

/**
 * `identity.provider` set in code (identity spec §9.2): which compiled-in
 * `UserPool` to use. The `IDENTITY_PROVIDER` environment variable names it
 * otherwise; a component of this type overrides the environment when its
 * `provider()` returns a name, and null defers to it. Declare at most one,
 * and put a `@Profile` on it to name a provider per environment's build
 * (§9.5).
 */
public interface IdentityConfig {
    String provider();
}
