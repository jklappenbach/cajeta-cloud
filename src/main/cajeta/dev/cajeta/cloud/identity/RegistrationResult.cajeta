package dev.cajeta.cloud.identity;

import cajeta.lang.String;

/**
 * What register returns (identity spec §3.1, §3.3): the provider's subject
 * for the new user and whether the account is already confirmed.
 */
public final class RegistrationResult {

    String id;
    boolean isConfirmed;

    public RegistrationResult(String subject, boolean confirmed) {
        this.id = "" + subject;
        this.isConfirmed = confirmed;
        return;
    }

    public #String subject() {
        String out = "" + this.id;
        return #out;
    }

    public boolean confirmed() { return this.isConfirmed; }
}
