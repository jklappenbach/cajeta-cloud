package dev.cajeta.cloud.identity;

import cajeta.lang.String;

/**
 * What register returns (identity spec §3.1, §3.3): the new user's id
 * and whether the account is already confirmed.
 */
public final class RegistrationResult {

    String id;
    boolean isConfirmed;

    public RegistrationResult(String userId, boolean confirmed) {
        this.id = "" + userId;
        this.isConfirmed = confirmed;
        return;
    }

    public #String userId() {
        String out = "" + this.id;
        return #out;
    }

    public boolean confirmed() { return this.isConfirmed; }
}
