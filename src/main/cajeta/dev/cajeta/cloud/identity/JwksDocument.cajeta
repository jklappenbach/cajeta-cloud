package dev.cajeta.cloud.identity;

import cajeta.lang.String;

/** A fetched key set and the lifetime its response granted (-1 when it named none). */
public final class JwksDocument {
    String doc;
    int64 age;

    public JwksDocument(String json, int64 maxAgeSeconds) {
        this.doc = "" + json;
        this.age = maxAgeSeconds;
        return;
    }

    public #String json() {
        String out = "" + this.doc;
        return #out;
    }

    public int64 maxAge() { return this.age; }

    /**
     * The lifetime a `Cache-Control` value grants in seconds: its max-age, 0
     * under no-store or no-cache, -1 when it names none (or is null).
     */
    public static int64 maxAgeOf(String header) {
        if (header == null) return -1L;
        String h #= header.toLowerCase();
        if (h.indexOf("no-store") >= 0L || h.indexOf("no-cache") >= 0L) return 0L;
        int64 at = h.indexOf("max-age=");
        if (at < 0L) return -1L;
        int32 i = (int32) at + 8;
        int32 n = h.byteLength();
        int64 v = 0L;
        boolean any = false;
        while (i < n) {
            int8 c = h.byteAt(i);
            if (c < (int8) 48 || c > (int8) 57) break;
            if (v < 100000000000L) v = v * 10L + (int64) (c - (int8) 48);
            any = true;
            i = i + 1;
        }
        if (!any) return -1L;
        return v;
    }
}
