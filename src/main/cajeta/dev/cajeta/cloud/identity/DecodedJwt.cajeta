package dev.cajeta.cloud.identity;

import cajeta.codec.Base64;
import cajeta.codec.Base64Exception;
import cajeta.codec.json.Json;
import cajeta.codec.json.JsonArray;
import cajeta.codec.json.JsonObject;
import cajeta.codec.json.JsonParseException;
import cajeta.codec.json.JsonValue;
import cajeta.collection.ArrayList;
import cajeta.lang.String;
import dev.cajeta.crypto.sig.InvalidKeyException;
import dev.cajeta.crypto.sig.Jwk;
import dev.cajeta.crypto.sig.JwsAlgorithm;
import dev.cajeta.crypto.sig.Signatures;

/**
 * A compact JWT split and decoded but not yet trusted (identity plan
 * 3.2.3): the header's algorithm and key id, the payload, and what the
 * signature covers. A verifier checks the signature against its JWKS with
 * {@link #verifiedBy} before it believes a single claim.
 */
public final class DecodedJwt {

    String algName;
    String keyId;
    JsonValue body;
    int8[] sig;
    String input;

    DecodedJwt() { return; }

    /** The header's `alg`. */
    public #String alg() {
        String out = "" + this.algName;
        return #out;
    }

    /** The header's `kid`, or "". */
    public #String kid() {
        String out = "" + this.keyId;
        return #out;
    }

    /**
     * Whether the signature verifies under the key in `keys` whose `kid`
     * is this token's (cajeta-crypto spec §7.1): RS256 or ES256, through
     * dev.cajeta.crypto. Any other algorithm, a token with no `kid`, a `kid`
     * the set does not hold, a key whose own `alg` names another algorithm,
     * or an unusable key answers false.
     */
    public boolean verifiedBy(Jwks keys) {
        JwsAlgorithm alg = JwsAlgorithm.RS256;
        if (this.algName.equals("ES256")) {
            alg = JwsAlgorithm.ES256;
        } else if (!this.algName.equals("RS256")) {
            return false;
        }
        if (this.keyId.byteLength() == 0) { return false; }
        try {
            String doc #= keys.json();
            JsonValue root #= Json.parse(doc);
            if (root.kind() != JsonValue.OBJECT) { return false; }
            JsonValue list = root.object().get("keys");
            if (list == null || list.kind() != JsonValue.ARRAY) { return false; }
            JsonArray arr = list.array();
            int32 i = 0;
            while (i < arr.count()) {
                JsonValue k = arr.get(i);
                if (k.kind() == JsonValue.OBJECT) {
                    String kid #= Jwt.member(k, "kid");
                    if (kid.equals(this.keyId)) {
                        return this.verifiedByKey(alg, k);
                    }
                }
                i = i + 1;
            }
        } catch (JsonParseException e) {
            return false;
        }
        return false;
    }

    boolean verifiedByKey(JwsAlgorithm alg, JsonValue k) {
        String keyAlg #= Jwt.member(k, "alg");
        if (keyAlg.byteLength() > 0 && !keyAlg.equals(this.algName)) { return false; }
        String kty #= Jwt.member(k, "kty");
        try {
            if (alg == JwsAlgorithm.RS256) {
                if (!kty.equals("RSA")) { return false; }
                int8[] n #= Base64.decode(Jwt.member(k, "n"));
                int8[] e #= Base64.decode(Jwt.member(k, "e"));
                Jwk rsa #= Jwk.rsa(n, n.count(), e, e.count());
                return this.checkedBy(alg, rsa);
            }
            String crv #= Jwt.member(k, "crv");
            if (!kty.equals("EC") || !crv.equals("P-256")) { return false; }
            int8[] x #= Base64.decode(Jwt.member(k, "x"));
            int8[] y #= Base64.decode(Jwt.member(k, "y"));
            if (x.count() != 32L || y.count() != 32L) { return false; }
            Jwk ec #= Jwk.p256(x, y);
            return this.checkedBy(alg, ec);
        } catch (InvalidKeyException e) {
            return false;
        } catch (Base64Exception e) {
            return false;
        }
        return false;
    }

    boolean checkedBy(JwsAlgorithm alg, Jwk key) {
        int8[] in #= this.input.toBytes();
        return Signatures.verify(alg, key, in, (int64) this.input.byteLength(),
            this.sig, (int64) this.sig.count());
    }

    /**
     * Refuse every algorithm but RS256 and ES256 (cajeta-crypto spec §7.2).
     * A verifier holds public keys, so it cannot check HS256, and taking a
     * public key as an HMAC secret is the classic forgery.
     */
    public void requireAsymmetric(String provider, String operation) {
        if (this.algName.equals("RS256") || this.algName.equals("ES256")) { return; }
        throw heap IdentityException(IdentityException.INVALID_TOKEN(),
            provider, operation, "-", "token failed the algorithm check: "
            + "only RS256 and ES256 are accepted");
    }

    /** The payload's claims, decoded (a fresh value each call). */
    public #Claims claims() {
        Attributes all = heap Attributes();
        ArrayList<String> groups = heap ArrayList<String>();
        int32 use = -1;
        int64 exp = 0L;
        int64 iat = 0L;
        JsonObject o = this.body.object();
        int32 i = 0;
        while (i < o.count()) {
            String name #= Jwt.unescape(o.keyAt(i), o.keyLenAt(i));
            JsonValue v = o.valueAt(i);
            int32 k = v.kind();
            if (k == JsonValue.STRING) {
                String text #= Jwt.unescape(v.asBytes(), v.asBytesLength());
                all.set(name, text);
            } else if (k == JsonValue.NUMBER) {
                int64 num = v.asInt64();
                String text #= "" + num;
                all.set(name, text);
                if (name.equals("exp")) { exp = num; }
                if (name.equals("iat")) { iat = num; }
            } else if (k == JsonValue.BOOLEAN) {
                String text = "false";
                if (v.asBoolean()) { text = "true"; }
                all.set(name, text);
            } else if (k == JsonValue.ARRAY && name.equals("groups")) {
                JsonArray arr = v.array();
                int32 j = 0;
                while (j < arr.count()) {
                    JsonValue g = arr.get(j);
                    if (g.kind() == JsonValue.STRING) {
                        String gs #= Jwt.unescape(g.asBytes(),
                            g.asBytesLength());
                        groups.add(#gs);
                    }
                    j = j + 1;
                }
            }
            i = i + 1;
        }
        String tu #= all.get("token_use");
        if (tu.equals("access")) { use = TokenUse.ACCESS(); }
        if (tu.equals("id")) { use = TokenUse.ID(); }
        Claims c = heap Claims(#all, #groups, use, exp, iat);
        return #c;
    }
}
