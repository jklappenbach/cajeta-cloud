package dev.cajeta.cloud.identity;

import cajeta.collection.HashMap;
import cajeta.concurrent.Lock;
import cajeta.lang.String;

/**
 * The memory driver's shared guts, held by both the pool and its hooks
 * so neither references the interface-implementing class (the MemState
 * pattern). One lock guards every operation (identity spec §2.5).
 */
final class MemIdentityState {

    Lock lock;
    HashMap<String, MemUser> bySubject;
    HashMap<String, String> subjectByName;
    boolean confirmation;
    boolean customAttributes;
    boolean groups;

    MemIdentityState(boolean confirmation, boolean customAttributes,
                     boolean groups) {
        this.lock = heap Lock();
        this.bySubject = heap HashMap<String, MemUser>();
        this.subjectByName = heap HashMap<String, String>();
        this.confirmation = confirmation;
        this.customAttributes = customAttributes;
        this.groups = groups;
        return;
    }

    /** Under the held lock: the user, or user-not-found. */
    MemUser find(String subject, String operation) {
        MemUser u = this.bySubject.get(subject);
        if (u == null) {
            throw heap IdentityException(IdentityException.USER_NOT_FOUND(),
                "memory", operation, subject, "no such user");
        }
        return #= u;
    }
}
