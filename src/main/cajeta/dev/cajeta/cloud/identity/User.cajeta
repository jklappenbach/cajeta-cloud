package dev.cajeta.cloud.identity;

import cajeta.collection.ArrayList;
import cajeta.lang.String;

/**
 * A user as a lookup returns it (identity spec §3.5): subject, username,
 * confirmation state, attributes and groups. The value is owned by the
 * caller and is a snapshot, never a window into driver state (§2.4).
 */
public final class User {

    String subjectId;
    String userName;
    boolean isConfirmed;
    Attributes attrs;
    ArrayList<String> groupNames;

    public User(String subject, String username, boolean confirmed,
                #Attributes attributes, #ArrayList<String> groups) {
        this.subjectId = "" + subject;
        this.userName = "" + username;
        this.isConfirmed = confirmed;
        this.attrs #= attributes;
        this.groupNames #= groups;
        return;
    }

    /** The provider's subject, stable for the account's life (§3.1); the application's own id is not this. */
    public #String subject() {
        String out = "" + this.subjectId;
        return #out;
    }

    public #String username() {
        String out = "" + this.userName;
        return #out;
    }

    public boolean confirmed() { return this.isConfirmed; }

    /** The attributes, a view into this snapshot. */
    public Attributes attributes() { return this.attrs; }

    public int32 groupCount() { return this.groupNames.count(); }

    public #String groupAt(int32 i) {
        String out = "" + this.groupNames.get(i);
        return #out;
    }

    public boolean inGroup(String group) {
        int32 i = 0;
        while (i < this.groupNames.count()) {
            if (this.groupNames.get(i).equals(group)) { return true; }
            i = i + 1;
        }
        return false;
    }
}
