package dev.cajeta.cloud.identity;

import cajeta.collection.ArrayList;
import cajeta.concurrent.LockGuard;
import cajeta.lang.Guid;
import cajeta.lang.String;
import dev.cajeta.cloud.Capabilities;

/**
 * The in-memory user pool (identity spec §1.3): the reference
 * implementation and the default when no adapter is compiled in. It is
 * faithful to the contract including its failures: a duplicate username
 * conflicts under real concurrency, a wrong code is rejected, and a
 * password is stored as a salted hash under a format tag (§4.7), never
 * as the password. Confirmation codes are never delivered; the test
 * seam {@link #hooks} exposes them (§3.7).
 */
@Component(name = "memory")
public final class MemoryUserPool implements UserPool {

    MemIdentityState st;
    MemoryIdentityHooks hookSeam;
    MemoryAuthenticator auth;
    MemoryAccount acct;
    MemoryTokenVerifier ver;

    /** Every capability but PASSKEYS and INTROSPECTION (§8.2), on the wall clock. */
    public MemoryUserPool() {
        SystemTimeSource sys = heap SystemTimeSource();
        String[] all #= MemoryUserPool.everything();
        this.init(all, #sys);
        return;
    }

    /** Uninitialized; the factories call init. */
    MemoryUserPool(int32 bare) { return; }

    /**
     * Every capability, on the given clock (§6.5). The pool borrows the
     * clock, so the caller keeps it alive longer than the pool.
     */
    public static #MemoryUserPool withClock(TimeSource clock) {
        MemoryUserPool p = heap MemoryUserPool(0);
        String[] all #= MemoryUserPool.everything();
        p.init(all, #clock);
        return #p;
    }

    /** A driver declaring only the given capabilities, for undeclared-branch tests. */
    public static #MemoryUserPool withCapabilities(boolean confirmation,
                                                   boolean customAttributes,
                                                   boolean groups) {
        int32 n = 0;
        if (confirmation) { n = n + 1; }
        if (customAttributes) { n = n + 1; }
        if (groups) { n = n + 1; }
        String[] names = heap String[n];
        int32 i = 0;
        if (confirmation) { names[i] #= IdentityCapability.CONFIRMATION(); i = i + 1; }
        if (customAttributes) { names[i] #= IdentityCapability.CUSTOM_ATTRIBUTES(); i = i + 1; }
        if (groups) { names[i] #= IdentityCapability.GROUPS(); i = i + 1; }
        return MemoryUserPool.declaring(names);
    }

    /** A driver declaring exactly the named capabilities, on the wall clock. */
    public static #MemoryUserPool declaring(String[] capabilities) {
        MemoryUserPool p = heap MemoryUserPool(0);
        SystemTimeSource sys = heap SystemTimeSource();
        p.init(capabilities, #sys);
        return #p;
    }

    /** What the memory driver declares by default: all of §8.1 and §15.12, §15.18 but PASSKEYS and INTROSPECTION. */
    static #String[] everything() {
        String[] out = [IdentityCapability.CONFIRMATION(),
            IdentityCapability.TOTP(), IdentityCapability.SMS_OTP(),
            IdentityCapability.EMAIL_OTP(), IdentityCapability.REFRESH(),
            IdentityCapability.REVOCATION(),
            IdentityCapability.CUSTOM_ATTRIBUTES(),
            IdentityCapability.GROUPS(), IdentityCapability.JWKS(),
            IdentityCapability.ADMIN(), IdentityCapability.PASSWORD_RESET(),
            IdentityCapability.PASSWORDLESS(),
            IdentityCapability.TOTP_SIGN_IN()];
        return #out;
    }

    static #String caveat(String capability) {
        String c = "";
        if (capability.equals("identity.confirmation")
                || capability.equals("identity.sms-otp")
                || capability.equals("identity.email-otp")
                || capability.equals("identity.password-reset")) {
            c = "codes are exposed through MemoryIdentityHooks, never sent";
        }
        if (capability.equals("identity.custom-attributes")) {
            c = "names are 1 to 64 bytes without whitespace";
        }
        if (capability.equals("identity.totp")
                || capability.equals("identity.totp-sign-in")) {
            c = "seeds are held in process memory only and die with it (§15.18.9)";
        }
        if (capability.equals("identity.jwks")) {
            c = "ES256 under a per-process key pair that dies with the process, so it is for tests and development only";
        }
        return #c;
    }

    void init(String[] declared, TimeSource clock) {
        this.st #= heap MemIdentityState(#clock);
        Capabilities c = heap Capabilities("memory");
        int32 i = 0;
        while (i < declared.count()) {
            String note #= MemoryUserPool.caveat(declared[i]);
            c.declare(declared[i], note);
            i = i + 1;
        }
        this.st.caps #= c;
        this.hookSeam #= heap MemoryIdentityHooks(this.st);
        this.auth #= heap MemoryAuthenticator(this.st);
        this.acct #= heap MemoryAccount(this.st);
        this.ver #= heap MemoryTokenVerifier(this.st);
        return;
    }

    /** The test seam (§3.7). */
    public MemoryIdentityHooks hooks() { return this.hookSeam; }

    public Capabilities capabilities() { return this.st.caps; }

    public Authenticator authenticator() { return this.auth; }

    public Account account() { return this.acct; }

    public TokenVerifier verifier() { return this.ver; }

    /** Require TOTP of every password sign-in: a user without it is answered MFA_SETUP (§6.1). */
    public void requireTotp(boolean required) {
        this.st.totpRequired = required;
        return;
    }

    void requireCap(String capability, String operation, String subject) {
        this.st.requireCap(capability, operation, subject);
        return;
    }

    static void checkName(String name, String operation, String subject) {
        int32 n = name.byteLength();
        boolean ok = n >= 1 && n <= 64;
        int32 i = 0;
        while (ok && i < n) {
            int8 b = name.byteAt(i);
            if (b == (int8) 32 || b == (int8) 9 || b == (int8) 10
                    || b == (int8) 13) {
                ok = false;
            }
            i = i + 1;
        }
        if (!ok) {
            throw heap IdentityException(
                IdentityException.POLICY_VIOLATION(), "memory", operation,
                subject, "attribute and group names are 1 to 64 bytes "
                + "without whitespace");
        }
        return;
    }

    static #String freshCode(boolean wanted) {
        if (!wanted) {
            String none = "";
            return #none;
        }
        return MemCrypto.sixDigits();
    }

    #RegistrationResult create(String username, String password,
                               Attributes attributes, String operation,
                               boolean passwordless) {
        if (username.byteLength() < 1) {
            throw heap IdentityException(
                IdentityException.POLICY_VIOLATION(), "memory", operation,
                username, "username must not be empty");
        }
        if (!passwordless && password.byteLength() < 8) {
            throw heap IdentityException(
                IdentityException.POLICY_VIOLATION(), "memory", operation,
                username, "password must be at least 8 bytes");
        }
        if (attributes.count() > 0) {
            this.requireCap(IdentityCapability.CUSTOM_ATTRIBUTES(),
                operation, username);
            int32 i = 0;
            while (i < attributes.count()) {
                MemoryUserPool.checkName(attributes.nameAt(i), operation,
                    username);
                i = i + 1;
            }
        }
        String rec = "";
        if (!passwordless) { rec #= MemCrypto.passwordRecord(password); }
        Attributes attrs #= attributes.copy();
        boolean confirmation = this.st.caps.supports(
            IdentityCapability.CONFIRMATION());
        String code #= MemoryUserPool.freshCode(confirmation);
        boolean confirmed = !confirmation;
        LockGuard g #= this.st.lock.acquire();
        if (this.st.subjectByName.containsKey(username)) {
            throw heap IdentityException(IdentityException.USER_EXISTS(),
                "memory", operation, username, "username is taken");
        }
        String id #= Guid.random().toString();
        String idKey = "" + id;
        String nameKey = "" + username;
        String idValue = "" + id;
        this.st.bySubject.put(#idKey, heap MemUser(id, username, confirmed,
            #rec, #attrs, #code));
        this.st.subjectByName.put(#nameKey, #idValue);
        RegistrationResult r = heap RegistrationResult(id, confirmed);
        return #r;
    }

    public #RegistrationResult register(String username, String password) {
        Attributes none = heap Attributes();
        return this.create(username, password, none, "register", false);
    }

    public #RegistrationResult registerWith(String username, String password,
                                            Attributes attributes) {
        return this.create(username, password, attributes, "registerWith",
            false);
    }

    public #RegistrationResult registerPasswordless(String username,
                                                    Attributes attributes) {
        this.requireCap(IdentityCapability.PASSWORDLESS(),
            "registerPasswordless", username);
        return this.create(username, "", attributes, "registerPasswordless",
            true);
    }

    public void confirm(String username, String code) {
        this.requireCap(IdentityCapability.CONFIRMATION(), "confirm", username);
        LockGuard g #= this.st.lock.acquire();
        String subject = this.st.subjectByName.get(username);
        if (subject == null) {
            throw heap IdentityException(IdentityException.USER_NOT_FOUND(),
                "memory", "confirm", username, "no such user");
        }
        MemUser u = this.st.find(subject, "confirm");
        if (u.confirmed) { return; }
        if (!u.code.equals(code)) {
            throw heap IdentityException(IdentityException.INVALID_CODE(),
                "memory", "confirm", username,
                "confirmation code does not match");
        }
        u.confirmed = true;
        return;
    }

    static #User snapshot(MemUser u) {
        Attributes attrs #= u.attrs.copy();
        ArrayList<String> groups = heap ArrayList<String>();
        int32 i = 0;
        while (i < u.groups.count()) {
            String g = "" + u.groups.get(i);
            groups.add(#g);
            i = i + 1;
        }
        User out = heap User(u.subject, u.username, u.confirmed, #attrs, #groups);
        return #out;
    }

    public #User lookupBySubject(String subject) {
        LockGuard g #= this.st.lock.acquire();
        MemUser u = this.st.find(subject, "lookupBySubject");
        return MemoryUserPool.snapshot(u);
    }

    public #User lookupByName(String username) {
        LockGuard g #= this.st.lock.acquire();
        String id = this.st.subjectByName.get(username);
        if (id == null) {
            throw heap IdentityException(IdentityException.USER_NOT_FOUND(),
                "memory", "lookupByName", username, "no such user");
        }
        MemUser u = this.st.find(id, "lookupByName");
        return MemoryUserPool.snapshot(u);
    }

    public boolean delete(String subject) {
        LockGuard g #= this.st.lock.acquire();
        MemUser u = this.st.bySubject.get(subject);
        if (u == null) { return false; }
        String name = "" + u.username;
        String id = "" + subject;
        this.st.revokeAll(id);
        String droppedId #= this.st.subjectByName.remove(name);
        MemUser dropped #= this.st.bySubject.remove(subject);
        return true;
    }

    public void setAttribute(String subject, String name, String value) {
        this.requireCap(IdentityCapability.CUSTOM_ATTRIBUTES(),
            "setAttribute", subject);
        MemoryUserPool.checkName(name, "setAttribute", subject);
        LockGuard g #= this.st.lock.acquire();
        MemUser u = this.st.find(subject, "setAttribute");
        u.attrs.set(name, value);
        return;
    }

    public void removeAttribute(String subject, String name) {
        this.requireCap(IdentityCapability.CUSTOM_ATTRIBUTES(),
            "removeAttribute", subject);
        LockGuard g #= this.st.lock.acquire();
        MemUser u = this.st.find(subject, "removeAttribute");
        boolean was = u.attrs.remove(name);
        return;
    }

    public void addToGroup(String subject, String group) {
        this.requireCap(IdentityCapability.GROUPS(), "addToGroup", subject);
        MemoryUserPool.checkName(group, "addToGroup", subject);
        LockGuard g #= this.st.lock.acquire();
        MemUser u = this.st.find(subject, "addToGroup");
        if (u.groupIndex(group) < 0) {
            String copy = "" + group;
            u.groups.add(#copy);
        }
        return;
    }

    public void removeFromGroup(String subject, String group) {
        this.requireCap(IdentityCapability.GROUPS(), "removeFromGroup",
            subject);
        LockGuard g #= this.st.lock.acquire();
        MemUser u = this.st.find(subject, "removeFromGroup");
        int32 at = u.groupIndex(group);
        if (at >= 0) {
            String dropped #= u.groups.removeAt(at);
        }
        return;
    }

    public #String[] groups(String subject) {
        this.requireCap(IdentityCapability.GROUPS(), "groups", subject);
        LockGuard g #= this.st.lock.acquire();
        MemUser u = this.st.find(subject, "groups");
        int32 n = u.groups.count();
        String[] out = heap String[n];
        int32 i = 0;
        while (i < n) {
            out[i] #= "" + u.groups.get(i);
            i = i + 1;
        }
        return #out;
    }
}
