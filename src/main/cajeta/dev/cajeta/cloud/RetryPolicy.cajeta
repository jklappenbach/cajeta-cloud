package dev.cajeta.cloud;

import cajeta.math.Tensor;
import cajeta.math.random.Generator;

/**
 * Exponential backoff with jitter (spec §11.2), configurable and
 * DETERMINISTIC under a seed so retry schedules are testable: delay
 * for attempt `k` is `min(base·2ᵏ, max)`, multiplied by a jitter drawn
 * uniformly from `[0.5, 1.0]` from the policy's own seeded stream.
 * Retry applies only to {@link CloudException#isTransient} failures —
 * retrying a NOT_FOUND or PRECONDITION_FAILED just repeats the answer.
 */
public final class RetryPolicy {

    int32 maxAttempts;
    int64 baseMillis;
    int64 maxMillis;
    Generator jitter;

    public RetryPolicy(int32 maxAttempts, int64 baseMillis,
                       int64 maxMillis, uint64 seed) {
        if (maxAttempts < 1 || baseMillis < 1 || maxMillis < baseMillis) {
            throw heap CloudException(CloudException.PROVIDER_ERROR(),
                "policy", "RetryPolicy", "-",
                "need maxAttempts >= 1 and 1 <= baseMillis <= maxMillis");
        }
        this.maxAttempts = maxAttempts;
        this.baseMillis = baseMillis;
        this.maxMillis = maxMillis;
        this.jitter = heap Generator(seed);
        return;
    }

    /** The defaults: 4 attempts, 100 ms base, 5 s cap. */
    public static #RetryPolicy standard(uint64 seed) {
        return heap RetryPolicy((int32) 4, (int64) 100, (int64) 5000,
                                seed);
    }

    /** Attempts before giving up. */
    public int32 attempts() { return this.maxAttempts; }

    /** True when `e` is worth retrying (§11.2). */
    public boolean shouldRetry(CloudException e, int32 attempt) {
        return e.isTransient() && attempt + 1 < this.maxAttempts;
    }

    /** Jittered delay before attempt `k+1` (k is 0-based). */
    public int64 delayMillis(int32 attempt) {
        int64 raw = this.baseMillis;
        int32 k = 0;
        while (k < attempt && raw < this.maxMillis) {
            raw = raw * 2;
            k = k + 1;
        }
        if (raw > this.maxMillis) { raw = this.maxMillis; }
        Tensor<float32> u #= this.jitter.uniform((int64) 1);
        float64 factor = 0.5 + 0.5 * (float64) u.flatGet((int64) 0);
        int64 out = (int64) ((float64) raw * factor);
        if (out < 1) { out = 1; }
        return out;
    }
}
